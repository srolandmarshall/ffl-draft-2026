# Copy to .env and fill in. .env is git-ignored; this file is not, so never
# put real credentials here.
#
# dotenv only loads in development and test. Production values belong in the
# host's secret manager.

# --- Sign-in email (required in development) ---------------------------------
# Sign-in mails a six-digit code through Resend in development too, and
# raise_delivery_errors is on, so signing in fails without a key. To work
# without email, mint a code directly:
#   bin/rails runner 'puts User.find_by_any_email("you@example.com").issue_login_code!'
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=draft@example.com

# --- ESPN (required to sync the player pool and league history) --------------
# Session cookies from a browser signed in to ESPN. They expire; re-copy them
# when a sync starts returning auth errors. The league ID is not set here — it
# lives on the league record as espn_league_id.
ESPN_S2=
ESPN_SWID={00000000-0000-0000-0000-000000000000}

# --- Optional -----------------------------------------------------------------
# Rankings provider: league_logs (default) or fantasy_football_calculator.
# PLAYER_RANKINGS_SOURCE=league_logs

# Season used by db:seed. Defaults to the current calendar year.
# LEAGUE_SEASON=2026

# Dev server port. bin/dev defaults to 52477.
# PORT=52477

# --- Production only ----------------------------------------------------------
# Listed for reference. Set these in the deployment environment, not in .env.
#
# APP_HOST=                  canonical host for generated URLs
# SOLID_QUEUE_IN_PUMA=true   run background jobs inside the web process
# S3_BUCKET=                 Active Storage bucket for player headshots
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CDN_HOST=                  optional CDN in front of Active Storage
# RAILS_LOG_LEVEL=info
# RAILS_MAX_THREADS=         Puma threads per process
# WEB_CONCURRENCY=           Puma worker processes
# JOB_CONCURRENCY=           Solid Queue worker processes
# JOB_THREADS=               Solid Queue threads per worker
