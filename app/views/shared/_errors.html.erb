<% if record.errors.any? %>
  <div class="mb-5 rounded-xl border border-red-400/40 bg-red-400/10 p-4 text-sm text-red-200">
    <p class="font-semibold"><%= pluralize(record.errors.count, "error") %> prevented this from saving:</p>
    <ul class="mt-2 list-disc pl-5"><% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
