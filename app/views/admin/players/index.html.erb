<div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div><p class="text-sm font-bold text-lime-400">Player pool</p><h1 class="text-2xl font-semibold">Players</h1><p class="mt-1 text-sm text-slate-400"><%= Player.count %> total; ordered by current ADP.</p></div>
  <div class="flex flex-wrap gap-3"><%= link_to "Refresh ADP", new_admin_adp_import_path, class: "rounded border border-white/15 px-4 py-2 font-semibold hover:border-lime-400" %><%= button_to "Match ESPN IDs", admin_espn_player_sync_path, class: "cursor-pointer rounded border border-white/15 px-4 py-2 font-semibold hover:border-lime-400" %><%= button_to "Refresh actual stats", admin_nflverse_player_sync_path, class: "cursor-pointer rounded border border-white/15 px-4 py-2 font-semibold hover:border-lime-400" %><%= link_to "Import CSV", new_admin_player_import_path, class: "rounded border border-white/15 px-4 py-2 font-semibold hover:border-lime-400" %><%= link_to "+ Add player", new_admin_player_path, class: "rounded bg-lime-400 px-4 py-2 font-semibold text-slate-950" %></div>
</div>
<div class="overflow-hidden rounded-lg border border-white/10 bg-slate-900">
  <table class="w-full text-left text-sm"><thead class="bg-slate-800 text-xs uppercase tracking-wider text-slate-400"><tr><th class="px-4 py-3">Player</th><th class="px-3 py-3">Pos</th><th class="px-3 py-3">NFL</th><th class="px-3 py-3">ADP</th><th class="hidden px-3 py-3 sm:table-cell">ESPN ID</th><th></th></tr></thead>
    <tbody class="divide-y divide-white/5"><% @players.each do |player| %><tr><td class="px-4 py-3 font-bold"><%= player.name %><% unless player.active? %><span class="ml-2 text-xs text-slate-500">inactive</span><% end %></td><td class="px-3 py-3"><%= player.position %></td><td class="px-3 py-3 text-slate-400"><%= player.pro_team %></td><td class="px-3 py-3 text-slate-300"><%= player.adp_formatted || "—" %></td><td class="hidden px-3 py-3 text-slate-500 sm:table-cell"><%= player.espn_id || "—" %></td><td class="px-4 py-3 text-right"><%= link_to "Edit", edit_admin_player_path(player), class: "font-bold text-lime-400" %></td></tr><% end %></tbody>
  </table>
</div>
