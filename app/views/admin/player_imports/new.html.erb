<div class="mx-auto max-w-2xl">
  <p class="text-sm font-bold text-lime-400">Player pool</p><h1 class="text-2xl font-semibold">Import CSV</h1>
  <p class="mt-3 text-slate-400">Required headers: <code class="text-slate-200">name,position,pro_team</code>. Optional: <code class="text-slate-200">espn_id,bye_week,active</code>. Existing ESPN IDs are updated safely.</p>
  <%= form_with url: admin_player_import_path, multipart: true, class: "mt-7 rounded-lg border border-white/10 bg-slate-900 p-6" do |form| %>
    <%= form.file_field :file, accept: ".csv,text/csv", required: true, class: "block w-full rounded-lg border border-white/15 bg-slate-950 p-3 text-sm" %>
    <%= form.submit "Import players", class: "mt-5 cursor-pointer rounded-lg bg-lime-400 px-5 py-2.5 font-semibold text-slate-950" %>
  <% end %>
</div>
