<%= render "shared/errors", record: team %>
<%= form_with model: [:admin, league, team], class: "space-y-5" do |form| %>
  <div><%= form.label :name, class: "mb-2 block text-sm font-bold" %><%= form.text_field :name, autofocus: true, class: "w-full rounded-lg border border-white/15 bg-slate-950 px-3 py-2.5" %></div>
  <div><%= form.label :owner_name, class: "mb-2 block text-sm font-bold" %><%= form.text_field :owner_name, class: "w-full rounded-lg border border-white/15 bg-slate-950 px-3 py-2.5" %></div>
  <div><%= form.label :abbreviation, "Abbreviation (2–5 letters)", class: "mb-2 block text-sm font-bold" %><%= form.text_field :abbreviation, maxlength: 5, class: "w-full rounded-lg border border-white/15 bg-slate-950 px-3 py-2.5" %></div>
  <div><%= form.label :emails, "Team emails", class: "mb-2 block text-sm font-bold" %><%= form.text_area :emails, value: team.emails.join("\n"), rows: 3, class: "w-full rounded-lg border border-white/15 bg-slate-950 px-3 py-2.5", placeholder: "owner@example.com\nco-owner@example.com" %><p class="mt-2 text-xs text-slate-500">One or more email addresses, separated by commas, spaces, or new lines.</p></div>
  <%= form.submit class: "cursor-pointer rounded-lg bg-lime-400 px-5 py-2.5 font-semibold text-slate-950" %>
<% end %>
