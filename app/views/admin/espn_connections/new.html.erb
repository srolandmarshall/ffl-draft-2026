<div class="mx-auto max-w-xl">
  <p class="text-sm font-bold text-lime-400">ESPN integration</p>
  <h1 class="text-2xl font-semibold">Connect private ESPN league</h1>
  <p class="mt-2 text-sm text-slate-400"><%= @league.name %> is associated with ESPN league #<%= @league.espn_league_id %> for <%= @league.season %>.</p>

  <div class="mt-6 rounded-lg border border-white/10 bg-slate-900 p-6">
    <div class="mb-6 rounded-lg border border-white/10 bg-slate-950 p-4 text-sm text-slate-300">
      <p class="font-bold text-white">Get the two cookie values from ESPN</p>
      <ol class="mt-2 list-decimal space-y-1 pl-5 text-xs leading-relaxed text-slate-400">
        <li><%= link_to "Sign in to ESPN Fantasy", "https://fantasy.espn.com/football/", target: "_blank", rel: "noopener", class: "font-bold text-lime-400 hover:text-lime-300" %>.</li>
        <li>Open your browser's developer tools, then Application/Storage → Cookies → espn.com.</li>
        <li>Copy the values named <code>espn_s2</code> and <code>SWID</code> below.</li>
      </ol>
    </div>
    <%= form_with url: admin_league_espn_connection_path(@league), class: "space-y-5" do |form| %>
      <div><%= form.label :espn_s2, "espn_s2 cookie", class: "mb-2 block text-sm font-bold" %><%= form.password_field :espn_s2, required: true, autocomplete: "off", class: "w-full rounded-lg border border-white/15 bg-slate-950 px-3 py-2.5" %></div>
      <div><%= form.label :swid, "SWID cookie", class: "mb-2 block text-sm font-bold" %><%= form.password_field :swid, required: true, autocomplete: "off", placeholder: "{XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}", class: "w-full rounded-lg border border-white/15 bg-slate-950 px-3 py-2.5" %></div>
      <p class="text-xs leading-relaxed text-slate-500">These values are verified with ESPN and retained only in this browser's encrypted Rails session. They are never saved to the database, and signing out removes them.</p>
      <div class="flex gap-3"><%= form.submit "Connect and sync league", class: "cursor-pointer rounded-lg bg-lime-400 px-4 py-2 font-bold text-slate-950 hover:bg-lime-300" %><%= link_to "Cancel", admin_league_path(@league), class: "rounded-lg border border-white/15 px-4 py-2 font-bold" %></div>
    <% end %>
  </div>
</div>
