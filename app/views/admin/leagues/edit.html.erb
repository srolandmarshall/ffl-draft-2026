<div class="mx-auto max-w-2xl">
  <p class="text-sm font-bold text-lime-400">League setup</p>
  <h1 class="mb-7 text-2xl font-semibold">Edit league</h1>

  <div class="rounded-lg border border-white/10 bg-slate-900 p-6">
    <%= render "form", league: @league %>
  </div>

  <section class="mt-8 rounded-lg border border-red-400/30 bg-red-400/5 p-6">
    <h2 class="font-semibold text-red-200">Delete league</h2>
    <p class="mt-2 text-sm text-slate-400">Permanently deletes this league, including every team, draft, and pick.</p>
    <%= button_to "Delete league", admin_league_path(@league), method: :delete, class: "mt-4 cursor-pointer rounded-lg border border-red-400/40 px-4 py-2 font-bold text-red-200 hover:bg-red-400/10", form: { data: { turbo_confirm: "Delete #{@league.name}? This permanently deletes its teams, drafts, and picks." } } %>
  </section>
</div>
