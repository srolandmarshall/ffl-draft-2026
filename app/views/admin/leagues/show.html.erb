<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div><p class="text-sm font-bold text-lime-400"><%= @league.season %> season</p><h1 class="text-2xl font-semibold"><%= @league.name %></h1><p class="mt-2 text-sm text-slate-400"><%= @league.roster_size %> roster spots per team</p></div>
  <%= link_to "Edit league", edit_admin_league_path(@league), class: "rounded-lg border border-white/15 px-4 py-2 text-center font-bold hover:border-lime-400" %>
</div>

<section class="mb-8 rounded-lg border border-white/10 bg-slate-900 p-4">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-slate-500">ESPN integration</p>
      <% if @league.espn_league_id.present? %>
        <p class="mt-1 font-semibold">League #<%= @league.espn_league_id %> · <%= @league.season %></p>
        <p class="mt-1 text-xs text-slate-500"><%= @league.espn_synced_at ? "Last synced #{time_ago_in_words(@league.espn_synced_at)} ago · #{@espn_seasons.size} seasons of history" : "Connected; league data has not been synced yet." %></p>
      <% else %>
        <p class="mt-1 text-sm text-slate-400">No ESPN league is associated with this league.</p>
      <% end %>
    </div>
    <% if @league.espn_league_id.present? %>
      <div class="flex flex-wrap gap-2"><%= button_to "Sync ESPN league", admin_league_espn_settings_sync_path(@league), class: "cursor-pointer rounded-lg bg-lime-400 px-4 py-2 text-sm font-bold text-slate-950 hover:bg-lime-300" %><% if @espn_seasons.any? %><%= link_to "View league history", league_history_path(@league), class: "rounded-lg border border-blue-400/30 bg-blue-400/10 px-4 py-2 text-sm font-bold text-blue-200" %><% end %><% if espn_connected? %><%= button_to "Disconnect ESPN", admin_league_espn_connection_path(@league), method: :delete, class: "cursor-pointer rounded-lg border border-white/15 px-4 py-2 text-sm font-bold" %><% else %><%= link_to "Connect private league", new_admin_league_espn_connection_path(@league), class: "rounded-lg border border-white/15 px-4 py-2 text-sm font-bold hover:border-lime-400" %><% end %></div>
    <% else %>
      <%= link_to "Connect ESPN league", edit_admin_league_path(@league), class: "rounded-lg border border-white/15 px-4 py-2 text-center text-sm font-bold hover:border-lime-400" %>
    <% end %>
  </div>
  <% if @espn_settings %>
    <div class="mt-4 grid gap-3 border-t border-white/5 pt-4 lg:grid-cols-3">
      <div><p class="text-[.65rem] font-bold uppercase tracking-wider text-slate-500">Roster</p><p class="mt-1 text-xs text-slate-300"><%= @espn_settings.lineup_rules.map { |position, count| "#{position} #{count}" }.join(" · ") %></p></div>
      <div><p class="text-[.65rem] font-bold uppercase tracking-wider text-slate-500">League rules</p><p class="mt-1 text-xs text-slate-300"><%= @espn_settings.league_rules.first(4).map { |rule| "#{rule.label}: #{rule.value}" }.join(" · ").presence || "No additional rules returned" %></p></div>
      <details><summary class="cursor-pointer text-[.65rem] font-bold uppercase tracking-wider text-lime-400">All scoring rules (<%= @espn_settings.scoring_rules.size %>)</summary><div class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1"><% @espn_settings.scoring_rules.each do |rule| %><span class="text-[.65rem] text-slate-400"><%= rule.label %>: <strong class="text-slate-200"><%= rule.value %></strong></span><% end %></div></details>
    </div>
  <% end %>
  <p class="mt-3 border-t border-white/5 pt-3 text-[.65rem] text-slate-600">ESPN syncs team identities, rules, and draft history. It never changes the draft order saved here; new ESPN teams are appended.</p>
</section>

<div class="grid gap-8 lg:grid-cols-2">
  <%= turbo_frame_tag "league-#{@league.id}-teams" do %>
  <section>
    <div class="mb-4 flex items-center justify-between"><div><h2 class="text-xl font-semibold">Next draft order</h2><p class="mt-1 text-xs text-slate-500">Drag teams into place. Existing drafts keep their saved order.</p></div><%= link_to "+ Add team", new_admin_league_team_path(@league), data: { turbo_frame: "_top" }, class: "text-sm font-semibold text-lime-400 hover:text-lime-300" %></div>
    <%= form_with url: team_order_admin_league_path(@league), method: :patch, data: { controller: "team-order" } do %>
      <p class="mb-2 min-h-5 text-xs font-semibold text-lime-400" data-team-order-target="status"></p>
      <div class="overflow-hidden rounded-lg border border-white/10 bg-slate-900">
        <% @teams.each.with_index(1) do |team, position| %>
          <div draggable="true" data-team-id="<%= team.id %>" data-team-order-target="item" data-action="dragstart->team-order#dragStart dragover->team-order#dragOver drop->team-order#drop dragend->team-order#dragEnd" class="flex cursor-move items-center gap-2 border-b border-white/5 px-3 py-2 last:border-0 hover:bg-white/[.03]">
            <%= hidden_field_tag "team_ids[]", team.id %>
            <span class="select-none text-slate-600" aria-hidden="true">⠿</span>
            <span class="w-6 shrink-0 text-center text-xs font-bold text-lime-400" data-team-order-target="position"><%= position %></span>
            <span class="w-12 shrink-0 text-xs font-semibold text-slate-500"><%= team.abbreviation %></span>
            <p class="min-w-0 flex-1 truncate text-sm font-semibold"><%= team.name %><span class="hidden font-normal text-slate-500 md:inline"> · <%= team.owner_name %></span></p>
            <%= link_to "Edit", edit_admin_league_team_path(@league, team), data: { turbo_frame: "_top" }, class: "text-xs font-bold text-slate-400 hover:text-white" %>
          </div>
        <% end %>
        <% if @teams.empty? %><p class="p-7 text-center text-sm text-slate-500">Add teams before creating a draft.</p><% end %>
      </div>
      <% if @teams.many? %><%= submit_tag "Save order", class: "mt-3 cursor-pointer rounded-lg border border-white/15 px-3 py-2 text-xs font-bold hover:border-lime-400" %><% end %>
    <% end %>
  </section>
  <% end %>
  <%= turbo_frame_tag "league-#{@league.id}-drafts" do %>
  <section>
    <div class="mb-4 flex items-center justify-between"><h2 class="text-xl font-semibold">Drafts</h2><%= link_to "+ Create draft", new_admin_league_draft_path(@league), data: { turbo_frame: "_top" }, class: "text-sm font-semibold text-lime-400 hover:text-lime-300" %></div>
    <div class="space-y-3">
      <% @drafts.each do |draft| %>
        <div class="rounded-lg border border-white/10 bg-slate-900 p-5">
          <div class="flex items-start justify-between">
            <div><p class="font-semibold"><%= draft.name %></p><p class="text-sm text-slate-400"><%= draft.team_count %> teams · <%= draft.rounds %> rounds · <%= draft.ppr.to_f %> PPR · <%= draft.status %></p></div>
            <% if draft.complete? %>
              <%= link_to "View draft result →", draft_path(draft.public_id, view: "board"), data: { turbo_frame: "_top" }, class: "text-sm font-bold text-lime-400" %>
            <% else %>
              <%= link_to "Open room →", draft_path(draft.public_id), data: { turbo_frame: "_top" }, class: "text-sm font-bold text-lime-400" %>
            <% end %>
          </div>
          <div class="mt-4 flex flex-wrap gap-3">
            <% if draft.setup? %><%= button_to "Start draft", start_admin_league_draft_path(@league, draft), method: :patch, class: "cursor-pointer rounded-lg bg-lime-400 px-3 py-2 text-xs font-semibold text-slate-950" %><%= link_to "Edit", edit_admin_league_draft_path(@league, draft), data: { turbo_frame: "_top" }, class: "rounded-lg border border-white/10 px-3 py-2 text-xs font-bold" %><% else %><%= button_to "Restart draft", restart_admin_league_draft_path(@league, draft), method: :patch, class: "cursor-pointer rounded-lg border border-amber-400/40 px-3 py-2 text-xs font-bold text-amber-200 hover:bg-amber-400/10", form: { data: { turbo_confirm: "Restart #{draft.name}? This permanently removes all picks and starts it over." } } %><% end %>
            <%= button_to "Delete draft", admin_league_draft_path(@league, draft), method: :delete, class: "cursor-pointer rounded-lg border border-red-400/40 px-3 py-2 text-xs font-bold text-red-200 hover:bg-red-400/10", form: { data: { turbo_confirm: "Delete #{draft.name}? This permanently removes the draft and all picks." } } %>
          </div>
        </div>
      <% end %>
      <% if @drafts.empty? %><div class="rounded-lg border border-dashed border-white/15 p-7 text-center text-sm text-slate-500">No drafts yet.</div><% end %>
    </div>
  </section>
  <% end %>
</div>
