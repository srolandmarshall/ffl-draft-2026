<div class="mb-6 flex items-end justify-between"><h1 class="text-2xl font-semibold">Leagues</h1><%= link_to "+ New league", new_admin_league_path, class: "rounded-lg bg-lime-400 px-4 py-2 font-semibold text-slate-950" %></div>
<div class="space-y-3"><% @leagues.each do |league| %><%= link_to "#{league.name} · #{league.season}", admin_league_path(league), class: "block rounded-xl border border-white/10 bg-slate-900 p-4 font-bold hover:border-lime-400" %><% end %></div>
