<div id="<%= dom_id(draft, :room) %>" class="space-y-4" data-controller="draft-pick" data-action="draft:turn->draft-pick#turnChanged" data-draft-pick-selected-team-id-value="<%= selected_team&.id %>" data-draft-pick-commissioner-value="<%= current_user.commissioner? %>">
  <%= turbo_frame_tag "draft-#{draft.public_id}-clock", class: "sticky top-0 z-30 block" do %>
    <%= render Components::Drafts::Clock.new(draft:, selected_team:, picks_until_selected_team:, picks:, current_pick_elapsed_seconds:, current_user:) %>
  <% end %>

  <nav class="grid grid-cols-3 overflow-hidden rounded-xl border border-white/15 bg-slate-900 shadow-xl shadow-black/20" aria-label="Draft room view">
    <%= link_to draft_path(draft.public_id), class: "group px-2 py-3 transition sm:px-5 sm:py-4 #{params[:view].blank? ? 'bg-white text-slate-950' : 'text-slate-400 hover:bg-white/5 hover:text-white'}" do %>
      <span class="block text-base font-black sm:text-lg">Player list</span>
      <span class="mt-0.5 block text-[.65rem] font-semibold sm:text-xs">Search, compare, and make your pick</span>
    <% end %>
    <%= link_to draft_path(draft.public_id, view: "my_team", team_id: (selected_team&.id if current_user.commissioner?)), class: "group border-l border-white/15 px-2 py-3 transition sm:px-5 sm:py-4 #{params[:view] == 'my_team' ? 'text-slate-950' : 'text-blue-300 hover:bg-white/5'}", style: ("background-color: var(--color-blue-300)" if params[:view] == "my_team") do %>
      <span class="block text-base font-black sm:text-lg">Team Rosters</span>
      <span class="mt-0.5 block text-[.65rem] font-semibold sm:text-xs"><%= current_user.commissioner? ? "Choose and review a roster" : "Review your drafted roster" %></span>
    <% end %>
    <%= link_to draft_path(draft.public_id, view: "board"), class: "group border-l border-white/15 px-2 py-3 transition sm:px-5 sm:py-4 #{params[:view] == 'board' ? 'bg-lime-400 text-slate-950' : 'text-lime-400 hover:bg-white/5'}" do %>
      <span class="block text-base font-black sm:text-lg">Draft board</span>
      <span class="mt-0.5 block text-[.65rem] font-semibold sm:text-xs">See every team and round at once</span>
    <% end %>
  </nav>

  <div>
  <%= render Components::Drafts::RecentPicks.new(draft:, picks:, pick_elapsed_seconds:) %>
  </div>

  <section class="min-w-0">
    <% if params[:view] == "board" %>
      <%= render Components::Drafts::Board.new(draft:, picks:, pick_elapsed_seconds:, selected_team:) %>
    <% elsif params[:view] == "my_team" %>
      <%= turbo_frame_tag "draft-#{draft.public_id}-team-roster" do %>
        <%= render Components::Drafts::TeamRoster.new(draft:, team: roster_team, picks:, commissioner: current_user.commissioner?, preferred_team: selected_team) %>
      <% end %>
    <% else %>
      <%= render "players", draft:, available_players:, available_teams:, player_filters:, can_make_pick: draft.live? && (current_user.commissioner? || selected_team == draft.current_team) %>
    <% end %>
  </section>
</div>
