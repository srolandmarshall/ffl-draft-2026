<div id="<%= dom_id(draft, :room) %>" class="space-y-4" data-controller="draft-pick draft-alert" data-action="draft:turn->draft-pick#turnChanged draft:turn->draft-alert#turnChanged" data-draft-pick-selected-team-id-value="<%= selected_team&.id %>" data-draft-pick-commissioner-value="<%= current_user.commissioner? %>" data-draft-alert-selected-team-id-value="<%= selected_team&.id %>" data-draft-alert-current-team-id-value="<%= draft.current_team&.id %>" data-draft-alert-enabled-value="<%= selected_team.present? && !current_user.commissioner? %>" data-draft-alert-sound-url-value="/its-your-pick.mp3">
  <nav class="grid grid-cols-2 overflow-hidden rounded-xl border border-white/15 bg-slate-900 shadow-xl shadow-black/20" aria-label="Draft room view">
    <%= link_to draft_path(draft.public_id), class: "group px-4 py-4 transition sm:px-5 #{params[:view] == 'board' ? 'text-slate-400 hover:bg-white/5 hover:text-white' : 'bg-white text-slate-950'}" do %>
      <span class="block text-base font-black sm:text-lg">Player list</span>
      <span class="mt-0.5 block text-[.65rem] font-semibold sm:text-xs">Search, compare, and make your pick</span>
    <% end %>
    <%= link_to draft_path(draft.public_id, view: "board"), class: "group border-l border-white/15 px-4 py-4 transition sm:px-5 #{params[:view] == 'board' ? 'bg-lime-400 text-slate-950' : 'text-lime-400 hover:bg-white/5'}" do %>
      <span class="block text-base font-black sm:text-lg">Draft board</span>
      <span class="mt-0.5 block text-[.65rem] font-semibold sm:text-xs">See every team and round at once</span>
    <% end %>
  </nav>

  <div class="flex flex-wrap items-start justify-end gap-2">
  <%= turbo_frame_tag "draft-#{draft.public_id}-clock" do %>
    <%= render Components::Drafts::Clock.new(draft:, selected_team:, picks_until_selected_team:, picks:, current_pick_elapsed_seconds:, current_user:) %>
  <% end %>

  <%= render Components::Drafts::RecentPicks.new(draft:, picks:, pick_elapsed_seconds:) %>
  </div>

  <section class="min-w-0">
    <% if params[:view] == "board" %>
      <%= render Components::Drafts::Board.new(draft:, picks:, pick_elapsed_seconds:, selected_team:) %>
    <% else %>
      <%= render "players", draft:, available_players:, available_teams:, player_filters:, can_make_pick: draft.live? && (current_user.commissioner? || selected_team == draft.current_team) %>
    <% end %>
  </section>
</div>
