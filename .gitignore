# Rails runtime and local state
/log/*
/tmp/*
/storage/*
/app/assets/builds/*
/public/assets/*
!/log/.keep
!/tmp/.keep
!/storage/.keep
!/app/assets/builds/.keep

# Local secrets and credentials
/.env
/.env.*
!/.env.example
/config/master.key

# Local developer tooling
/.ruby-lsp/
.DS_Store

# Imported personal roster data
/team_assignments.csv

# Real league seed data: member names and email addresses. db/seeds.rb falls
# back to generated placeholder teams when no file is present.
/db/seeds/*.json
